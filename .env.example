# Salin file ini menjadi .env lalu isi dengan nilai asli dari dashboard Supabase Anda
# (Project Settings > API). Anon key aman ditaruh di frontend karena dibatasi oleh
# Row Level Security (lihat supabase/schema.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-anda
